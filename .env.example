# Copy to .env.local; never put a live Key in the repository.
# With no Key, all map views use OpenStreetMap.
VITE_MAP_PROVIDER=osm
VITE_TENCENT_MAP_KEY=

# Optional custom Leaflet tile service. Keep its required attribution.
# VITE_TILE_URL=https://your-tile-service/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=Your required attribution
